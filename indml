    <script>
        // --- CONTROL DE VISTAS UNIFICADAS ---
        function switchView(viewName, el) {
            document.querySelectorAll('.app-view').forEach(v => v.classList.remove('active-view'));
            document.querySelectorAll('.btn-nav').forEach(b => b.classList.remove('active'));

            if (viewName === 'chat') document.getElementById('view-chat').classList.add('active-view');
            if (viewName === 'calc') {
                document.getElementById('view-calc').classList.add('active-view');
                cargarTasasDropdown();
            }
            if (viewName === 'contacts') {
                document.getElementById('view-contacts').classList.add('active-view');
                pintarAgendaContactos();
            }
            el.classList.add('active');
        }

        // --- NÚCLEO FIREBASE & INDEXEDDB (SPACECHAT) ---
        const firebaseConfig = {
            apiKey: "AIzaSyCaUyhX2iBMl4A5xeKeu4SeE6HClp4V1s",
            authDomain: "real-market-elite-2025.firebaseapp.com",
            projectId: "real-market-elite-2025",
            databaseURL: "https://real-market-elite-2025-default-rtdb.firebaseio.com",
            messagingSenderId: "226489002778",
            appId: "1:226489002778:web:6722d21a9e78b33b5b1aa3"
        };
        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();

        // IndexedDB v11 Setup
        function abrirDB() {
            return new Promise((resolve, reject) => {
                const request = indexedDB.open("DropisDB", 11);
                request.onupgradeneeded = (e) => {
                    const db = e.target.result;
                    if (!db.objectStoreNames.contains('mensajes')) db.createObjectStore('mensajes', { autoIncrement: true });
                    if (!db.objectStoreNames.contains('perfiles')) db.createObjectStore('perfiles', { keyPath: 'id' });
                };
                request.onsuccess = () => resolve(request.result);
                request.onerror = () => reject("Error DB");
            });
        }

        async function guardarLocal(tabla, datos) {
            const dbInstance = await abrirDB();
            return new Promise((resolve) => {
                const tx = dbInstance.transaction(tabla, 'readwrite');
                tx.objectStore(tabla).put(datos);
                tx.oncomplete = () => resolve(true);
            });
        }

        async function obtenerTodo(tabla) {
            const dbInstance = await abrirDB();
            return new Promise((resolve) => {
                const tx = dbInstance.transaction(tabla, 'readonly');
                const req = tx.objectStore(tabla).getAll();
                req.onsuccess = () => resolve(req.result);
            });
        }

        // --- MOTOR DE TASAS (DROPISAPP INTEGRADOR) ---
        let tApi = { bcv: 36.5, euro: 39.2, p2p: 41.5 };
        let tasaSeleccionada = 'bcv';

        function selectTasa(tipo) {
            tasaSeleccionada = tipo;
            document.getElementById('cardBCV').classList.toggle('selected', tipo === 'bcv');
            document.getElementById('cardEuro').classList.toggle('selected', tipo === 'euro');
            calcularTasasPanel();
        }

        async function cargarTasasDropdown() {
            try {
                const res = await fetch("https://raw.githubusercontent.com/alfonsocamacho00089-cloud/BcvEuroapp.py/main/Bcveuro_vigente.json");
                const data = await res.json();
                if (data && data.length > 0) {
                    tApi.bcv = parseFloat(data[0].precio_dolar) || 36.5;
                    tApi.euro = parseFloat(data[0].precio_euro) || 39.2;
                }
            } catch (e) { console.log("Usando tasas predeterminadas BCV"); }

            try {
                const resP = await fetch("https://raw.githubusercontent.com/alfonsocamacho00089-cloud/P2papp.py/main/p2p.json");
                const dataP = await resP.json();
                if (dataP && dataP.binance_p2p) {
                    tApi.p2p = Math.max(...Object.values(dataP.binance_p2p.ventas_sell)) || 41.5;
                }
            } catch (e) { console.log("Usando tasas P2P base"); }

            document.getElementById('bcvRate').value = tApi.bcv.toFixed(2);
            document.getElementById('euroRate').value = tApi.euro.toFixed(2);
            document.getElementById('p2pRate').value = tApi.p2p.toFixed(2);
            calcularTasasPanel();
        }

        function calcularTasasPanel() {
            const pUSD = parseFloat(document.getElementById('priceUSD').value) || 0;
            const tBase = (tasaSeleccionada === 'bcv') ? tApi.bcv : tApi.euro;
            const nombreTasa = (tasaSeleccionada === 'bcv') ? "BCV" : "EURO";

            const baseBS = pUSD * tBase;
            const igtfBS = baseBS * 0.03;
            const totalBS = baseBS + igtfBS;
            const totalUSDT = tApi.p2p > 0 ? (totalBS / tApi.p2p) : 0;

            document.getElementById('labelVES').textContent = `${nombreTasa} ${baseBS.toLocaleString('es-VE', {minimumFractionDigits:2})} + IGTF`;
            document.getElementById('totalVES').value = totalBS.toLocaleString('es-VE', {minimumFractionDigits:2}) + " Bs";
            document.getElementById('totalUSDT').value = totalUSDT.toFixed(2);
        }

        document.getElementById('priceUSD').addEventListener('input', calcularTasasPanel);

        // --- MENSAJERÍA Y CHAT BASE ---
        async function enviarMensajeSatelital() {
            const inputMsg = document.querySelector('#msg-text');
            const msg = inputMsg ? inputMsg.value.trim() : "";
            if (!msg) return;

            pintarMensaje(msg, 'msg-derecha', null, 'enviado', 'msg_' + Date.now());
            inputMsg.value = "";
            inputMsg.style.height = '40px';
        }

        function pintarMensaje(texto, clase, hora, status, id) {
            const box = document.getElementById('chat-box');
            if (!box) return;
            const div = document.createElement('div');
            div.className = `mensaje msg-burbuja ${clase}`;
            div.innerHTML = `<span>${texto}</span><div style="font-size:10px; opacity:0.7; text-align:right; margin-top:2px;">${hora || 'Ahora'}</div>`;
            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
        }

        async function pintarAgendaContactos() {
            const lista = document.getElementById('lista-contactos');
            if (!lista) return;
            const contactos = JSON.parse(localStorage.getItem('mis_contactos')) || [];
            lista.innerHTML = "";
            
            if(contactos.length === 0) {
                lista.innerHTML = '<p style="color:#8696a0; text-align:center;">No hay contactos guardados.</p>';
                return;
            }

            contactos.forEach(c => {
                lista.innerHTML += `<div style="background:#111; padding:12px; border-radius:10px; margin-bottom:8px; display:flex; justify-content:space-between; align-items:center;">
                    <div><strong>${c.nombre}</strong><div style="font-size:11px; color:#8696a0;">ID: ${c.id}</div></div>
                </div>`;
            });
        }

        window.onload = () => {
            const splash = document.getElementById('pantalla-carga');
            if (splash) {
                splash.style.opacity = '0';
                setTimeout(() => splash.style.display = 'none', 500);
            }
            cargarTasasDropdown();
        };
    </script>
